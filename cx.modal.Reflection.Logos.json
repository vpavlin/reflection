{
  "id": "cx.modal.Reflection",
  "runtime": "org.gnome.Platform",
  "runtime-version": "49",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "reflection",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=wayland",
    "--env=RUST_BACKTRACE=1",
    "--env=RUST_LOG=reflection=INFO,reflection_doc=INFO,reflection_node=INFO,p2panda=INFO,p2panda_net=WARN,p2panda_discovery=WARN,p2panda_sync=WARN",
    "--env=REFLECTION_BACKEND=logos",
    "--env=REFLECTION_LOGOS_LIB=/app/lib/logos/liblogosdelivery.so"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "build-args": [
      "--share=network"
    ]
  },
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "libspelling",
      "builddir": true,
      "buildsystem": "meson",
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/GNOME/libspelling.git",
          "tag": "0.4.9",
          "commit": "e41e11d6ca6f5af987a46caa08036d5f0f629892"
        }
      ],
      "config-opts": []
    },
    {
      "name": "logos-delivery",
      "buildsystem": "simple",
      "build-options": {
        "strip": false,
        "no-debuginfo": true
      },
      "build-commands": [
        "install -Dm755 -t /app/lib/logos *.so*"
      ],
      "sources": [
        {
          "type": "archive",
          "only-arches": [
            "x86_64"
          ],
          "url": "https://data.vpavlin.xyz/reflection/logos-delivery/logos-delivery-0.3.0-2-x86_64.tar.gz",
          "sha256": "1af3f2296769607d64526d4a393d68e121a2580db7b14447f6b54516c6269395",
          "mirror-urls": [
            "https://github.com/vpavlin/reflection/releases/download/logos-delivery-0.3.0/logos-delivery-0.3.0-2-x86_64.tar.gz"
          ]
        },
        {
          "type": "archive",
          "only-arches": [
            "aarch64"
          ],
          "url": "https://data.vpavlin.xyz/reflection/logos-delivery/logos-delivery-0.3.0-2-aarch64.tar.gz",
          "sha256": "632a364ab291010f5eb34e5da933f119baa91d4c48bf9f493b5beca183ba5184",
          "mirror-urls": [
            "https://github.com/vpavlin/reflection/releases/download/logos-delivery-0.3.0/logos-delivery-0.3.0-2-aarch64.tar.gz"
          ]
        }
      ]
    },
    {
      "name": "reflection",
      "builddir": true,
      "buildsystem": "meson",
      "sources": [
        {
          "type": "git",
          "url": "./",
          "branch": "HEAD"
        }
      ],
      "config-opts": [
        "-Dlogos=true"
      ]
    }
  ],
  "branch": "logos"
}
